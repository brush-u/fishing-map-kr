# ===== 공공데이터포털(data.go.kr) 서비스키 =====
# 아래 키들은 각 API 상세페이지에서 "활용신청" 후 발급받은 "일반 인증키(Encoding)"를 넣으세요.

# 기상청_단기예보 조회서비스 (https://www.data.go.kr/data/15084084/openapi.do)
KMA_FORECAST_KEY=

# 해양수산부 국립해양조사원_조석예보 (https://www.data.go.kr/data/15038991/openapi.do)
KHOA_TIDE_KEY=

# 해양수산부_공동활용체계_갯바위낚시포인트 오픈API (활용신청 시 발급, https://www.data.go.kr/data/15148580/fileData.do)
MOF_ROCKPOINT_KEY=

# ===== 서버 설정 =====
PORT=8080

# Overpass API(OpenStreetMap)는 무료/키 불필요. 과도한 호출 방지를 위해 서버에서 캐싱합니다.
# 필요 시 미러 서버로 교체 가능:
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
